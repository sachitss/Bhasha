{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bhasha",
  "version": "1.0.1",
  "identifier": "com.sachitss.bhasha",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bhasha – German · English · Nepali",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Learn German, English and Nepali",
    "longDescription": "Bhasha teaches German, English and Nepali with native audio, spaced repetition, pronunciation practice and travel phrases.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
